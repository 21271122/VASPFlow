{
  "name": "dsh-vaspflow",
  "version": "0.2.3",
  "description": "VaspFlow for DeepSeek Harness: right-dock VASP task panel plus a shared Node data service whose vasp_* tools are available only in the bundled VASP Agent preset.",
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "dsh-vaspflow": "scripts/install-dsh.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "preset",
    "scripts/install-dsh.mjs",
    "scripts/install-preset.mjs",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.0",
    "antd": "^5.29.3",
    "recharts": "^2.15.4",
    "three": "^0.160.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "install-dsh": "node scripts/install-dsh.mjs",
    "install-preset": "node scripts/install-preset.mjs",
    "prepublishOnly": "npm run verify",
    "test": "node --test lib/host/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
